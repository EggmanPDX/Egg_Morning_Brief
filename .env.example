ANTHROPIC_API_KEY=your_anthropic_api_key_here
NOTION_API_KEY=your_notion_integration_token_here
APIFY_TOKEN=your_apify_api_token_here

# Notion page / database IDs
MORNING_BRIEFING_PAGE_ID=your_morning_briefing_page_id
D8_TASKS_SOURCE_ID=your_d8_tasks_data_source_id
BGC_TASKS_SOURCE_ID=your_bgc_tasks_data_source_id
D8_DB_PAGE_ID=your_d8_tasks_database_id
BGC_DB_PAGE_ID=your_bgc_tasks_database_id

# Gmail / Google OAuth
GMAIL_ADDRESS=you@example.com
GOOGLE_CREDENTIALS_PATH=~/.config/morning-brief/credentials.json
GOOGLE_TOKEN_PATH=~/.config/morning-brief/token.json

# Comma-separated sender names/emails whose mail is always analyzed
KEY_SENDERS=name1,name2,person@example.com

# Business context injected into the email-analysis prompt (one bullet per business)
BUSINESS_CONTEXT="- Company A: what it does. Key contacts: Name (role), Name (role).
- Company B: what it does. Key contacts: Name (role), Name (role)."
